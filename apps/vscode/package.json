{
	"name": "cerebriline",
	"displayName": "Cerebriline",
	"description": "Autonomous coding agent for your IDE. A Cline fork optimized for small local LLMs, with per-model prompt templating, expert escalation, sub-agents, and image generation.",
	"version": "4.100.126",
	"icon": "assets/icons/icon.png",
	"engines": {
		"vscode": "^1.101.0"
	},
	"author": {
		"name": "mann1x"
	},
	"license": "Apache-2.0",
	"publisher": "mann1x",
	"repository": {
		"type": "git",
		"url": "https://github.com/mann1x/cline"
	},
	"homepage": "https://github.com/mann1x/cline",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"cline",
		"claude",
		"dev",
		"mcp",
		"openrouter",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama"
	],
	"activationEvents": [
		"onLanguage",
		"onUri",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"icons": {
			"cline-icon": {
				"description": "cline",
				"default": {
					"fontPath": "assets/icons/cline-bot.woff",
					"fontCharacter": "\\e900"
				}
			}
		},
		"walkthroughs": [
			{
				"id": "CerebrilineWalkthrough",
				"title": "Meet Cerebriline, your new coding partner",
				"description": "Cerebriline codes like a developer because it thinks like one. Here are 5 ways to put it to work:",
				"steps": [
					{
						"id": "welcome",
						"title": "Start with a Goal, Not Just a Prompt",
						"description": "Tell Cerebriline what you want to achieve. It plans, asks, and then codes, like a true partner.",
						"media": {
							"markdown": "walkthrough/step1.md"
						}
					},
					{
						"id": "learn",
						"title": "Let Cerebriline Learn Your Codebase",
						"description": "Point Cerebriline to your project. It builds understanding to make smart, context-aware changes.",
						"media": {
							"markdown": "walkthrough/step2.md"
						}
					},
					{
						"id": "advanced-features",
						"title": "Always Use the Best AI Models",
						"description": "Cerebriline empowers you with State-of-the-Art AI, connecting to top models (Anthropic, Gemini, OpenAI & more).",
						"media": {
							"markdown": "walkthrough/step3.md"
						}
					},
					{
						"id": "mcp",
						"title": "Extend with Powerful Tools (MCP)",
						"description": "Connect to databases, APIs, and other external tools through MCP.",
						"media": {
							"markdown": "walkthrough/step4.md"
						}
					},
					{
						"id": "getting-started",
						"title": "You're Always in Control",
						"description": "Review Cerebriline's plans and diffs. Approve changes before they happen. No surprises.",
						"media": {
							"markdown": "walkthrough/step5.md"
						},
						"content": {
							"path": "walkthrough/step5.md"
						}
					}
				]
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "cerebriline-ActivityBar",
					"title": "Cerebriline",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"cerebriline-ActivityBar": [
				{
					"type": "webview",
					"id": "cerebriline.SidebarProvider",
					"name": "",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"commands": [
			{
				"command": "cerebriline.plusButtonClicked",
				"title": "New Task",
				"icon": "$(add)"
			},
			{
				"command": "cerebriline.mcpButtonClicked",
				"title": "MCP Servers",
				"icon": "$(server)"
			},
			{
				"command": "cerebriline.marketplaceButtonClicked",
				"title": "Customize",
				"icon": "$(wrench)"
			},
			{
				"command": "cerebriline.historyButtonClicked",
				"title": "History",
				"icon": "$(history)"
			},
			{
				"command": "cerebriline.accountButtonClicked",
				"title": "Account",
				"icon": "$(account)"
			},
			{
				"command": "cerebriline.settingsButtonClicked",
				"title": "Settings",
				"icon": "$(settings-gear)"
			},
			{
				"command": "cerebriline.dev.createTestTasks",
				"title": "Create Test Tasks",
				"category": "Cerebriline",
				"when": "cerebriline.isDevMode"
			},
			{
				"command": "cerebriline.dev.expireMcpOAuthTokens",
				"title": "Expire MCP OAuth Tokens (for testing)",
				"category": "Cerebriline",
				"when": "cerebriline.isDevMode"
			},
			{
				"command": "cerebriline.addToChat",
				"title": "Add to Cerebriline",
				"category": "Cerebriline"
			},
			{
				"command": "cerebriline.addTerminalOutputToChat",
				"title": "Add to Cerebriline",
				"category": "Cerebriline"
			},
			{
				"command": "cerebriline.focusChatInput",
				"title": "Jump to Chat Input",
				"category": "Cerebriline"
			},
			{
				"command": "cerebriline.generateGitCommitMessage",
				"title": "Generate Commit Message with Cerebriline",
				"category": "Cerebriline",
				"icon": "$(cline-icon)"
			},
			{
				"command": "cerebriline.abortGitCommitMessage",
				"title": "Generate Commit Message with Cerebriline - Stop",
				"category": "Cerebriline",
				"icon": "$(debug-stop)"
			},
			{
				"command": "cerebriline.explainCode",
				"title": "Explain with Cerebriline",
				"category": "Cerebriline"
			},
			{
				"command": "cerebriline.improveCode",
				"title": "Improve with Cerebriline",
				"category": "Cerebriline"
			},
			{
				"command": "cerebriline.jupyterGenerateCell",
				"title": "Generate Jupyter Cell with Cerebriline",
				"category": "Cerebriline",
				"icon": "$(sparkle)"
			},
			{
				"command": "cerebriline.jupyterExplainCell",
				"title": "Explain Jupyter Cell with Cerebriline",
				"category": "Cerebriline",
				"icon": "$(question)"
			},
			{
				"command": "cerebriline.jupyterImproveCell",
				"title": "Improve Jupyter Cell with Cerebriline",
				"category": "Cerebriline",
				"icon": "$(lightbulb)"
			},
			{
				"command": "cerebriline.openWalkthrough",
				"title": "Open Walkthrough",
				"category": "Cerebriline"
			},
			{
				"command": "cerebriline.checkForUpdates",
				"title": "Check for Updates",
				"category": "Cerebriline",
				"icon": "$(cloud-download)"
			}
		],
		"keybindings": [
			{
				"command": "cerebriline.addToChat",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "editorHasSelection"
			},
			{
				"command": "cerebriline.generateGitCommitMessage",
				"when": "config.git.enabled && scmProvider == git"
			},
			{
				"command": "cerebriline.focusChatInput",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "!editorHasSelection"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "cerebriline.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == cerebriline.SidebarProvider"
				},
				{
					"command": "cerebriline.marketplaceButtonClicked",
					"group": "navigation@2",
					"when": "view == cerebriline.SidebarProvider"
				},
				{
					"command": "cerebriline.historyButtonClicked",
					"group": "navigation@3",
					"when": "view == cerebriline.SidebarProvider"
				},
				{
					"command": "cerebriline.accountButtonClicked",
					"group": "navigation@5",
					"when": "view == cerebriline.SidebarProvider"
				},
				{
					"command": "cerebriline.settingsButtonClicked",
					"group": "navigation@6",
					"when": "view == cerebriline.SidebarProvider"
				}
			],
			"editor/context": [
				{
					"command": "cerebriline.addToChat",
					"group": "navigation",
					"when": "editorHasSelection"
				}
			],
			"terminal/context": [
				{
					"command": "cerebriline.addTerminalOutputToChat",
					"group": "navigation"
				}
			],
			"scm/title": [
				{
					"command": "cerebriline.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !cerebriline.isGeneratingCommit"
				},
				{
					"command": "cerebriline.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && cerebriline.isGeneratingCommit"
				}
			],
			"notebook/toolbar": [
				{
					"command": "cerebriline.jupyterGenerateCell",
					"group": "navigation/add@1",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"notebook/cell/title": [
				{
					"command": "cerebriline.jupyterExplainCell",
					"group": "inline@1",
					"when": "notebookType == 'jupyter-notebook'"
				},
				{
					"command": "cerebriline.jupyterImproveCell",
					"group": "inline@2",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"commandPalette": [
				{
					"command": "cerebriline.generateGitCommitMessage",
					"when": "config.git.enabled && !cerebriline.isGeneratingCommit"
				},
				{
					"command": "cerebriline.abortGitCommitMessage",
					"when": "config.git.enabled && cerebriline.isGeneratingCommit"
				}
			]
		},
		"configuration": {
			"title": "Cerebriline",
			"properties": {
				"cerebriline.lintCommand": {
					"type": "string",
					"default": "",
					"markdownDescription": "Command the `check_file` tool falls back to when the editor's language servers report nothing for a file. Use `${file}` for the file path; if omitted, the path is appended. Leave empty to rely on the editor alone, which is correct for any language with a working language server.",
					"examples": [
						"ruff check ${file}",
						"shellcheck",
						"npx eslint --format unix ${file}"
					]
				},
				"cerebriline.browserTool": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Offer the `browser` tool, which opens a page in a real browser and reports its console output and uncaught errors. Turn this off to remove it from the model's tools; Chrome is only launched if the model actually calls it."
				},
				"cerebriline.vscodeMcpTools": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Offer the tools of the MCP servers configured in **VS Code**, alongside the ones configured in Cerebriline. VS Code has already started and authenticated those servers, so this reaches ones Cerebriline cannot connect to on its own — a server that refuses dynamic client registration has no way to issue Cerebriline a client id, and VS Code already holds a token for it. Their names are prefixed `vscode__`. Turn this off to offer only the servers in Cerebriline's own MCP settings."
				},
				"cerebriline.vscodeMcpAutoApprove": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"markdownDescription": "Tools borrowed from VS Code's MCP servers that run without asking, by the name Cerebriline shows them under minus the `vscode__` prefix. Set from the tick boxes in Manage MCP Servers; the servers' own approval settings live in VS Code, where Cerebriline cannot read them, so this is Cerebriline's own list."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "bun run package",
		"compile": "bun run check-types && bun run lint && bun esbuild.mjs",
		"compile-standalone": "bun run check-types && bun run lint && bun esbuild.mjs --standalone",
		"postcompile-standalone": "node scripts/package-standalone.mjs",
		"dev": "bun run protos && bun run watch",
		"watch": "bun run --parallel watch:esbuild watch:tsc",
		"watch:esbuild": "bun esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "bun run build:sdk && bun run check-types && bun run build:webview && bun run lint && bun esbuild.mjs --production",
		"build:sdk": "cd ../.. && bun --production -F './sdk/packages/*' build",
		"protos": "node scripts/build-proto.mjs",
		"protos-python": "node scripts/build-python-proto.mjs",
		"download-ripgrep": "node scripts/download-ripgrep.mjs",
		"postprotos": "biome format --config-path ./biome.jsonc src/shared/proto src/core/controller src/hosts/ webview-ui/src/services src/generated --write --no-errors-on-unmatched",
		"clean:build": "rimraf dist dist-standalone webview-ui/build src/generated out/",
		"clean:deps": "rimraf node_modules webview-ui/node_modules",
		"clean:all": "bun run clean:build && bun run clean:deps",
		"compile-tests": "node ./scripts/build-tests.js",
		"watch-tests": "tsc -p . -w --outDir out",
		"typecheck": "bun run check-types",
		"check-types": "bun run protos && bunx tsc --noEmit && bun run check-types:compat && cd webview-ui && bunx tsc -b",
		"check-types:compat": "bunx tsc --project tsconfig.vscode-compat.json --noEmit",
		"lint": "biome lint --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error && bun run lint:proto",
		"lint:proto": "bash ./scripts/proto-lint.sh",
		"analyze:unused": "bunx --yes knip --config knip.json --include files,exports,types,enumMembers,duplicates",
		"analyze:unused:prod": "bunx --yes knip --config knip.json --production --include files,exports,types,enumMembers,dependencies",
		"analyze:unused:fix-exports": "node scripts/remove-unused-exports.mjs --apply",
		"analyze:unused:fix-exports:dry": "node scripts/remove-unused-exports.mjs",
		"format": "biome format --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error --semicolons=as-needed",
		"format:fix": "biome check --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --write --semicolons=as-needed",
		"fix:all": "biome check --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --write --diagnostic-level=error --unsafe --semicolons=as-needed",
		"ci:check-all": "bun run --parallel check-types lint format",
		"ci:build": "bun run protos && bun run build:webview && bun esbuild.mjs && bun run compile-tests",
		"pretest": "bun run compile && bun run compile-tests && bun run compile-standalone && bun run lint",
		"test": "bun run test:unit && bun run test:integration",
		"test:integration": "bun run compile-tests && vscode-test",
		"test:unit": "bun scripts/run-bun-unit-tests.ts",
		"test:vitest": "vitest run --config vitest.config.ts",
		"test:vitest:watch": "vitest --config vitest.config.ts",
		"test:bun": "bun scripts/run-bun-tests.ts",
		"test:bun:unit": "bun scripts/run-bun-unit-tests.ts",
		"test:coverage": "bun run compile-tests && vscode-test --coverage",
		"test:sca-server": "bun --watch scripts/test-standalone-core-api-server.ts",
		"test:tp-orchestrator": "bun scripts/testing-platform-orchestrator.ts",
		"dev:mcp-oauth-test-server": "bun src/dev/mcp-oauth-test-server/server.ts",
		"e2e": "playwright test -c playwright.config.ts",
		"test:e2e:build": "vsce package --no-dependencies --allow-package-secrets sendgrid --out dist/e2e.vsix",
		"test:e2e": "playwright install && bun run test:e2e:build && node src/test/e2e/utils/build.mjs && playwright test",
		"test:e2e:optimal": "bun run test:e2e:build && node src/test/e2e/utils/build.mjs && playwright test",
		"test:e2e:ui": "bun scripts/interactive-playwright.ts",
		"install:all": "bun install",
		"dev:webview": "node scripts/clean-webview-vite-cache.mjs && cd webview-ui && bun run dev",
		"build:webview": "bun run protos && cd webview-ui && bun run build",
		"test:webview": "cd webview-ui && bun run test",
		"publish:marketplace": "node scripts/publish-marketplace.mjs",
		"publish:marketplace:prerelease": "node scripts/publish-marketplace.mjs --pre-release",
		"publish:marketplace:nightly": "node ./scripts/publish-nightly.mjs",
		"docs": "cd docs && bun run dev",
		"docs:check-links": "cd docs && bun run check",
		"docs:rename-file": "cd docs && bun run rename",
		"report-issue": "node scripts/report-issue.js",
		"storybook": "cd webview-ui && bun run storybook",
		"eval:smoke:run": "bun evals/smoke-tests/run-smoke-tests.ts"
	},
	"lint-staged": {
		"src/shared/storage/state-keys.ts": [
			"node scripts/generate-state-proto.mjs",
			"git add apps/vscode/proto/cline/state.proto"
		],
		"*": [
			"biome check --write --staged --no-errors-on-unmatched --files-ignore-unknown=true --semicolons=as-needed"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@bufbuild/buf": "^1.54.0",
		"@microsoft/tui-test": "0.0.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/chai": "^5.0.1",
		"@types/clone-deep": "^4.0.4",
		"@types/get-folder-size": "^3.0.4",
		"@types/js-yaml": "^4.0.9",
		"@types/mocha": "^10.0.7",
