{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"rootDir": "..",
		"noEmit": true,
		"paths": {
			"@cline/shared": ["../shared/src/index.ts"],
			"@cline/shared/*": ["../shared/src/*", "../shared/src/*/index.ts"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
