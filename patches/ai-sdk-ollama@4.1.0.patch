diff --git a/dist/index.browser.cjs b/dist/index.browser.cjs
index d3ef55bf325bad1e1cb26259ed608f4bff2642b2..b5db034f283813d504bffc03f9b95a89518278ac 100644
--- a/dist/index.browser.cjs
+++ b/dist/index.browser.cjs
@@ -1408,13 +1408,20 @@ function convertToOllamaChatMessages(prompt) {
       }
       case "assistant": {
         let content;
+        let thinking;
         const toolCalls = [];
         if (typeof message.content === "string") {
           content = message.content;
         } else {
           const textParts = message.content.filter((part) => part.type === "text").map((part) => part.text).join("");
           const reasoningParts = message.content.filter((part) => part.type === "reasoning").map((part) => part.text).join("\n");
-          content = [textParts, reasoningParts].filter(Boolean).join("\n");
+          // Prior reasoning belongs in Ollama's own `thinking` field, not
+          // concatenated into `content`: folded into content it comes back to
+          // the model as something it said out loud, and renderers show it as
+          // answer text. `thinking` is what the chat template and the UI both
+          // expect, and what lets a model's own retention rules apply.
+          content = textParts;
+          thinking = reasoningParts;
           for (const part of message.content) {
             if (part.type !== "tool-call") {
               continue;
@@ -1434,6 +1441,7 @@ function convertToOllamaChatMessages(prompt) {
           role: "assistant",
           content: content || "",
           // Ensure content is never undefined
+          ...(thinking ? { thinking } : {}),
           tool_calls: toolCalls.length > 0 ? toolCalls : void 0
         });
         break;
